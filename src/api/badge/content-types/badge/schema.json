{
  "kind": "collectionType",
  "collectionName": "badges",
  "info": {
    "singularName": "badge",
    "pluralName": "badges",
    "displayName": "Badge",
    "description": "Earned badges: definitions, criteria (published on /badges/), artwork. Records per the 21 Aug task pack field list."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "definition": {
      "type": "text",
      "required": true
    },
    "criteria": {
      "type": "text",
      "required": true
    },
    "badge_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "standard",
        "tenure",
        "performance",
        "editorial",
        "integration"
      ]
    },
    "artwork": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "artwork_url": {
      "type": "string"
    },
    "display_order": {
      "type": "integer",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "tenure_years_required": {
      "type": "integer"
    },
    "review_date": {
      "type": "date"
    }
  }
}