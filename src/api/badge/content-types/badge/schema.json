{
  "kind": "collectionType",
  "collectionName": "badges",
  "info": {
    "singularName": "badge",
    "pluralName": "badges",
    "displayName": "Badge",
    "description": "Earned Badges programme (Section 17): Quality Lender, Customer Favourite, Enduring Excellence, Video Verified"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "medal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Existing badge artwork"
    },
    "criteria_text": {
      "type": "richtext",
      "required": true,
      "description": "Published criteria - badges are never sold (Section 17)"
    },
    "review_date": {
      "type": "date",
      "required": true,
      "description": "Annual review; badges can be withdrawn"
    },
    "withdrawn": {
      "type": "boolean",
      "default": false
    },
    "lenders": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::lender.lender",
      "inversedBy": "earned_badges"
    },
    "years_earned": {
      "type": "component",
      "component": "badge.year-earned",
      "repeatable": true,
      "description": "Global years the badge has been issued; per-lender years live on the lender relation via badge_awards JSON if needed"
    }
  }
}
