{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Site testimonials migrated from WP CPT \"testimonials\""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "wp_id": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "reviewerName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "reviewTitle": {
      "type": "string"
    },
    "review": {
      "type": "text"
    },
    "displayOnHomepage": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "description": "Star rating shown on the card; omitted from display when unset"
    },
    "reviewDate": {
      "type": "date",
      "description": "Date the review was originally left (not the CMS entry date)"
    },
    "source": {
      "type": "string",
      "description": "Where the review came from, e.g. Google — rendered as the source label"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
