{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Report",
    "description": "Smarter Loans Research editions (research hub package, Aug 2026)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "permanent_slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "description": "Permanent URL - editions are never unpublished (Section 9)"
    },
    "report_family": {
      "type": "enumeration",
      "enum": [
        "lending_demand_index",
        "loan_purpose",
        "business_funding_by_industry",
        "provincial_snapshots",
        "requested_amounts_benchmark",
        "credit_band_demand_mix",
        "state_of_borrowing"
      ],
      "required": true
    },
    "cadence": {
      "type": "enumeration",
      "enum": [
        "quarterly",
        "annual"
      ],
      "required": true
    },
    "subtitle": {
      "type": "text",
      "description": "The finding, red display treatment"
    },
    "edition_label": {
      "type": "string",
      "description": "e.g. Inaugural Edition"
    },
    "period_label": {
      "type": "string",
      "description": "e.g. First Half 2026"
    },
    "publication_date": {
      "type": "date",
      "description": "Set at publish time by Vlad"
    },
    "dek": {
      "type": "text"
    },
    "executive_quote": {
      "type": "text"
    },
    "quote_attribution": {
      "type": "string"
    },
    "hero_figure": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Hero band figure, doubles as the OG image (1600x900 minimum)"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "report.section-text",
        "report.figure-with-table",
        "report.pull-quote",
        "report.data-table"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "reviewed_date": {
      "type": "date"
    },
    "next_release_label": {
      "type": "string",
      "description": "e.g. Q3 2026 Edition"
    },
    "next_release_month": {
      "type": "string",
      "description": "e.g. October 2026"
    },
    "data_period_start": {
      "type": "date"
    },
    "data_period_end": {
      "type": "date"
    },
    "key_findings": {
      "type": "component",
      "component": "report.key-finding",
      "repeatable": true
    },
    "methodology": {
      "type": "richtext",
      "required": true,
      "description": "Aggregates only; min segment 100; nothing lender-attributable (Appendix D)"
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "tldr_answer": {
      "type": "text",
      "required": true,
      "description": "Quick answer: renders in the IN SHORT block, above the first H2 (the answer target)"
    },
    "faqContent": {
      "type": "component",
      "component": "lender.faq-item",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "action_log_refs": {
      "type": "json",
      "description": "References into the action log (Section 24)"
    }
  }
}
