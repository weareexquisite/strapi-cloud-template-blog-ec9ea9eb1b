{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company",
    "description": "Financial-services companies migrated from WP CPT \"company\""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "wp_id": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "website": {
      "type": "string"
    },
    "buttonLink": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "linkTarget": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone2": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "hoAddress": {
      "type": "text"
    },
    "amount": {
      "type": "string"
    },
    "loanOfferedInfo": {
      "type": "string"
    },
    "customField1": {
      "type": "text"
    },
    "customField2": {
      "type": "text"
    },
    "customField3": {
      "type": "text"
    },
    "canadianStates": {
      "type": "json"
    },
    "cities": {
      "type": "json"
    },
    "howLongInBusiness": {
      "type": "string"
    },
    "howManyBranches": {
      "type": "string"
    },
    "numberOfCustomers": {
      "type": "string"
    },
    "totalFunded": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "callCenterTiming": {
      "type": "string"
    },
    "physicalLocations": {
      "type": "text"
    },
    "facebook": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "linkedIn": {
      "type": "string"
    },
    "youtube": {
      "type": "string"
    },
    "pinterest": {
      "type": "string"
    },
    "introVideo": {
      "type": "text"
    },
    "addFaqToThePage": {
      "type": "boolean",
      "default": false
    },
    "faqContent": {
      "type": "component",
      "repeatable": true,
      "component": "lender.faq-item"
    },
    "loanOffered": {
      "type": "component",
      "repeatable": true,
      "component": "company.loan-offered"
    },
    "supportOffer": {
      "type": "component",
      "repeatable": true,
      "component": "lender.support-offer"
    },
    "videos": {
      "type": "component",
      "repeatable": true,
      "component": "lender.video"
    },
    "companyCategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category"
    },
    "primaryCompanyCategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::company-product.company-product",
      "mappedBy": "company"
    },
    "company_type": {
      "type": "enumeration",
      "enum": [
        "bank",
        "credit_union",
        "debt_relief",
        "credit_counselling",
        "insolvency_trustee",
        "fintech",
        "other"
      ]
    },
    "referral_url": {
      "type": "string"
    },
    "best_for": {
      "type": "text"
    },
    "not_for": {
      "type": "text"
    },
    "pros": {
      "type": "json"
    },
    "cons": {
      "type": "json"
    },
    "reviewed_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "review_date": {
      "type": "date"
    },
    "rates_last_reviewed": {
      "type": "date"
    },
    "tldr_answer": {
      "type": "text"
    },
    "action_log_refs": {
      "type": "json"
    }
  }
}
