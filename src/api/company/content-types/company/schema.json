{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company",
    "description": "Financial-services companies migrated from WP CPT \"company\""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "wp_id": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "website": {
      "type": "string"
    },
    "buttonLink": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "linkTarget": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone2": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "hoAddress": {
      "type": "text"
    },
    "amount": {
      "type": "string"
    },
    "loanOfferedInfo": {
      "type": "string"
    },
    "customField1": {
      "type": "text"
    },
    "customField2": {
      "type": "text"
    },
    "customField3": {
      "type": "text"
    },
    "canadianStates": {
      "type": "json"
    },
    "cities": {
      "type": "json"
    },
    "howLongInBusiness": {
      "type": "string"
    },
    "howManyBranches": {
      "type": "string"
    },
    "numberOfCustomers": {
      "type": "string"
    },
    "totalFunded": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "callCenterTiming": {
      "type": "string"
    },
    "physicalLocations": {
      "type": "text"
    },
    "facebook": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "linkedIn": {
      "type": "string"
    },
    "youtube": {
      "type": "string"
    },
    "pinterest": {
      "type": "string"
    },
    "introVideo": {
      "type": "text"
    },
    "addFaqToThePage": {
      "type": "boolean",
      "default": false
    },
    "faqContent": {
      "type": "component",
      "repeatable": true,
      "component": "lender.faq-item"
    },
    "loanOffered": {
      "type": "component",
      "repeatable": true,
      "component": "company.loan-offered"
    },
    "supportOffer": {
      "type": "component",
      "repeatable": true,
      "component": "lender.support-offer"
    },
    "videos": {
      "type": "component",
      "repeatable": true,
      "component": "lender.video"
    },
    "companyCategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category"
    },
    "primaryCompanyCategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::company-product.company-product",
      "mappedBy": "company"
    },
    "company_type": {
      "type": "enumeration",
      "enum": [
        "bank",
        "credit_union",
        "debt_relief",
        "credit_counselling",
        "insolvency_trustee",
        "fintech",
        "other"
      ]
    },
    "referral_url": {
      "type": "string"
    },
    "best_for": {
      "type": "text"
    },
    "not_for": {
      "type": "text"
    },
    "pros": {
      "type": "json"
    },
    "cons": {
      "type": "json"
    },
    "reviewed_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "review_date": {
      "type": "date"
    },
    "rates_last_reviewed": {
      "type": "date"
    },
    "tldr_answer": {
      "type": "text"
    },
    "action_log_refs": {
      "type": "json"
    },
    "legal_name": {
      "type": "string",
      "description": "Current registered entity - rebrands and acquisitions change this"
    },
    "trading_name": {
      "type": "string"
    },
    "former_names": {
      "type": "json",
      "description": "Rebrands and prior identities so a stale search still resolves"
    },
    "parent_company": {
      "type": "string"
    },
    "operating_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "acquired",
        "pivoted",
        "wound_down"
      ],
      "description": "Non-active never renders as a live listing: it redirects or carries a dated note"
    },
    "founded": {
      "type": "string"
    },
    "hq_province": {
      "type": "string"
    },
    "regulator_registration": {
      "type": "string",
      "description": "OSFI / provincial insurance regulator / LIT number / securities registration"
    },
    "sphere": {
      "type": "enumeration",
      "enum": [
        "consumer",
        "business"
      ]
    },
    "stage": {
      "type": "string",
      "description": "Which stage of the financial sphere this serves"
    },
    "categories": {
      "type": "json",
      "description": "Category page slugs this company appears on - membership derives from the record (fixes the DATA-09 gap)"
    },
    "one_liner": {
      "type": "text"
    },
    "source_url": {
      "type": "string",
      "description": "The company's own page, never an aggregator"
    },
    "last_verified": {
      "type": "date",
      "description": "Static stamp of an actual check, never auto-dated"
    },
    "confidence": {
      "type": "string",
      "description": "VERIFIED-PRIMARY / VERIFIED-MULTI / VERIFY - render gate"
    },
    "verification_notes": {
      "type": "text"
    },
    "analyst": {
      "type": "string",
      "description": "Named reviewer, as on lender profiles"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "company"
    }
  }
}
