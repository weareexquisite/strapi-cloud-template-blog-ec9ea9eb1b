{
  "kind": "collectionType",
  "collectionName": "lender_products",
  "info": {
    "singularName": "lender-product",
    "pluralName": "lender-products",
    "displayName": "Lender Product",
    "description": "Per-product structured record - the lender data standard (Section 5)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Display title, e.g. 'Business Term Loan'"
    },
    "lender": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lender.lender",
      "inversedBy": "products"
    },
    "product_type": {
      "type": "enumeration",
      "enum": [
        "term_loan",
        "line_of_credit",
        "merchant_cash_advance",
        "equipment_financing",
        "invoice_factoring",
        "instalment_loan",
        "personal_line_of_credit",
        "secured_personal_loan",
        "home_equity_loan",
        "mortgage",
        "auto_loan",
        "truck_loan",
        "payday_loan",
        "other"
      ],
      "required": true
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "business",
        "personal"
      ],
      "required": true
    },
    "amount_min": {
      "type": "biginteger",
      "required": false
    },
    "amount_max": {
      "type": "biginteger",
      "required": false
    },
    "rate_min": {
      "type": "decimal",
      "required": false
    },
    "rate_max": {
      "type": "decimal"
    },
    "rate_type": {
      "type": "enumeration",
      "enum": [
        "apr",
        "factor",
        "monthly",
        "fee_per_100",
        "fee_based"
      ],
      "required": false,
      "description": "MCAs display factor rates or cost per $10k, never APR (Section 16). fee_per_100: payday-style '$14 per $100 borrowed' (rate_min = dollars per $100). fee_based: '0% interest' products where cost lives in fees (rate_min = 0)."
    },
    "term_min_months": {
      "type": "integer"
    },
    "term_max_months": {
      "type": "integer"
    },
    "funding_speed_hours": {
      "type": "integer",
      "description": "Typical fastest funding, in hours"
    },
    "min_income_monthly": {
      "type": "integer"
    },
    "min_credit_band": {
      "type": "enumeration",
      "enum": [
        "any",
        "poor",
        "fair",
        "good",
        "excellent"
      ]
    },
    "income_types_accepted": {
      "type": "json",
      "description": "Array from: employment, self_employment, disability, pension, benefits, other"
    },
    "min_monthly_revenue": {
      "type": "integer"
    },
    "min_time_in_business_months": {
      "type": "integer"
    },
    "provinces_served": {
      "type": "json",
      "required": false,
      "description": "Array of province codes: AB, BC, MB, NB, NL, NS, NT, NU, ON, PE, QC, SK, YT"
    },
    "fees": {
      "type": "richtext"
    },
    "prepayment": {
      "type": "text"
    },
    "docs_required": {
      "type": "json",
      "description": "Array of document names"
    },
    "good_to_know": {
      "type": "text",
      "description": "One-line caveat shown on the product block"
    },
    "province_overrides": {
      "type": "component",
      "component": "product.province-override",
      "repeatable": true
    },
    "apply_slug": {
      "type": "string",
      "description": "preferred_lender value carried into apply.smarter.loans"
    },
    "rates_last_reviewed": {
      "type": "date",
      "required": false,
      "description": ">90 days old = flagged for re-verification (Section 5)"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Computed by lifecycle hook - true when every match-critical field is present. Incomplete products keep their profile but are excluded from matching pools (Section 5)."
    },
    "completeness_missing": {
      "type": "json",
      "description": "Computed by lifecycle hook - names of missing match-critical fields (admin worksheet for data completion)"
    }
  }
}
