{
  "kind": "collectionType",
  "collectionName": "company_products",
  "info": {
    "singularName": "company-product",
    "pluralName": "company-products",
    "displayName": "Company Product",
    "description": "Company Data Standard product record - one block per product, never blended (financial sphere package)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "products"
    },
    "product_type": {
      "type": "enumeration",
      "enum": [
        "savings_account",
        "chequing_account",
        "hybrid_account",
        "gic",
        "prepaid_card",
        "credit_builder",
        "debt_management_plan",
        "debt_restructuring",
        "consumer_proposal_admin",
        "insurance",
        "money_transfer",
        "business_account",
        "payment_processing",
        "accounting_software",
        "incorporation_service",
        "payroll_service",
        "other"
      ],
      "required": true
    },
    "interest_rate": {
      "type": "decimal",
      "description": "e.g. everyday savings rate"
    },
    "monthly_fee": {
      "type": "decimal"
    },
    "amount_min": {
      "type": "biginteger"
    },
    "amount_max": {
      "type": "biginteger"
    },
    "fees": {
      "type": "richtext"
    },
    "good_to_know": {
      "type": "text"
    },
    "province_overrides": {
      "type": "component",
      "component": "product.province-override",
      "repeatable": true
    },
    "referral_url": {
      "type": "string",
      "description": "Outbound referral link with disclosure (Section 18 exception)"
    },
    "rates_last_reviewed": {
      "type": "date",
      "required": false
    },
    "headline_rate": {
      "type": "string",
      "description": "Interest rate, cash back, or premium basis depending on category"
    },
    "rate_basis": {
      "type": "string",
      "description": "What the number actually is: savings vs promotional vs tiered are different claims"
    },
    "minimums": {
      "type": "text",
      "description": "Balance, deposit, income, coverage"
    },
    "provinces_served": {
      "type": "json",
      "description": "Insurance and credit unions are frequently provincial"
    },
    "insurance_protection": {
      "type": "string",
      "description": "CDIC, provincial deposit insurance, Assuris, or none. Never assume."
    },
    "source_url": {
      "type": "string"
    },
    "last_verified": {
      "type": "date"
    },
    "confidence": {
      "type": "string",
      "description": "VERIFY never renders"
    }
  }
}
