{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "Blog posts migrated from WP \"post\" type (flat blog \u2014 no categories/tags)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "wp_id": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "publishDate": {
      "type": "datetime"
    },
    "needsReview": {
      "type": "boolean",
      "default": false
    },
    "reviewNote": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "tldr_answer": {
      "type": "text"
    },
    "action_log_refs": {
      "type": "json"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "description": "Named reviewer (master doc s20). Set only when a genuine review happened - never backfilled onto legacy content"
    },
    "reviewed_date": {
      "type": "date",
      "description": "Renders 'Reviewed {date}' only when a reviewer is set"
    }
  }
}
